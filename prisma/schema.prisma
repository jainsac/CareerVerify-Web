generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
  CLAIM_PENDING
}

enum UserRole {
  EMPLOYEE
  EMPLOYER
  ADMIN
}

enum EmploymentStatus {
  ACTIVE
  LEFT
  DISPUTED
}

enum VerificationStatus {
  PENDING
  APPROVED
  VERIFIED
  REJECTED
  DISPUTED
  EXPIRED
}

model User {
  id String @id @default(cuid())
  email String @unique
  phone String? @unique
  passwordHash String
  name String
  accountStatus AccountStatus @default(ACTIVE)
  role UserRole @default(EMPLOYEE)
  invitedAt DateTime?
  activatedAt DateTime?
  careerProfile CareerProfile?
  organizationMemberships OrganizationMember[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notifications Notification[]
}

model CareerProfile {
  id String @id @default(cuid())
  userId String @unique
  careerId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  employments EmploymentRecord[]
  verificationRequests VerificationRequest[]
  publicVerificationTokens PublicVerificationToken[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id String @id @default(cuid())
  name String
  cin String?
  gstin String?
  verifiedAt DateTime?
  members OrganizationMember[]
  employments EmploymentRecord[]
  branding OrganizationBranding?
  integrationKeys IntegrationApiKey[]
  employeeAccounts CompanyEmployeeAccount[]
  employeeInvites EmployeeInvite[]
  createdAt DateTime @default(now())
}

model OrganizationBranding {
  id String @id @default(cuid())
  organizationId String @unique
  logoUrl String?
  primaryColor String?
  secondaryColor String?
  tagline String?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model IntegrationApiKey {
  id String @id @default(cuid())
  organizationId String
  name String
  keyPrefix String
  keyHash String @unique
  scopes String
  lastUsedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, revokedAt])
}

model OrganizationMember {
  id String @id @default(cuid())
  userId String
  organizationId String
  role String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([userId, organizationId])
}

model EmploymentRecord {
  id String @id @default(cuid())
  careerProfileId String
  organizationId String
  employeeCode String?
  designation String
  department String?
  employmentType String?
  joinedAt DateTime
  leftAt DateTime?
  resignationStatus String @default("NONE")
  resignationSubmittedAt DateTime?
  resignationReason String?
  resignationNoticeDate DateTime?
  resignationWithdrawnAt DateTime?
  status EmploymentStatus @default(ACTIVE)
  source String @default("MANUAL")
  externalEmployeeId String?
  verifiedAt DateTime?
  experienceLetterRef String?
  experienceLetter ExperienceLetter?
  remarks String?
  disputes EmploymentDispute[]
  companyEmployeeAccount CompanyEmployeeAccount?
  employeeInvites EmployeeInvite[]
  exitHistory EmploymentExitEvent[]
  resignationHistory EmploymentResignationEvent[]
  careerProfile CareerProfile @relation(fields: [careerProfileId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId, status])
  @@index([organizationId, externalEmployeeId])
}

model CompanyEmployeeAccount {
  id String @id @default(cuid())
  organizationId String
  employmentRecordId String @unique
  email String
  phone String?
  passwordHash String?
  status AccountStatus @default(INVITED)
  invitedAt DateTime @default(now())
  activatedAt DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employmentRecord EmploymentRecord? @relation(fields: [employmentRecordId], references: [id], onDelete: Cascade)
  @@unique([organizationId, email])
}

model EmployeeInvite {
  id String @id @default(cuid())
  organizationId String
  employmentRecordId String?
  email String
  tokenHash String @unique
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employmentRecord EmploymentRecord @relation(fields: [employmentRecordId], references: [id], onDelete: Cascade)
  @@index([organizationId, expiresAt])
}

model EmploymentExitEvent {
  id String @id @default(cuid())
  employmentRecordId String
  action String
  reason String?
  performedByUserId String
  createdAt DateTime @default(now())
  employmentRecord EmploymentRecord @relation(fields: [employmentRecordId], references: [id], onDelete: Cascade)
  @@index([employmentRecordId, createdAt])
}

model EmploymentResignationEvent {
  id String @id @default(cuid())
  employmentRecordId String
  action String
  reason String?
  performedByUserId String
  createdAt DateTime @default(now())
  employmentRecord EmploymentRecord @relation(fields: [employmentRecordId], references: [id], onDelete: Cascade)
  @@index([employmentRecordId, createdAt])
}

model ExperienceLetter {
  id String @id @default(cuid())
  employmentRecordId String @unique
  documentRef String?
  storagePath String?
  documentHash String?
  verificationTokenHash String? @unique
  issuedAt DateTime @default(now())
  revokedAt DateTime?
  employmentRecord EmploymentRecord @relation(fields: [employmentRecordId], references: [id], onDelete: Cascade)
}

model EmploymentDispute {
  id String @id @default(cuid())
  employmentRecordId String
  raisedByUserId String
  reason String
  status String @default("OPEN")
  resolution String?
  resolvedByUserId String?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  employmentRecord EmploymentRecord @relation(fields: [employmentRecordId], references: [id], onDelete: Cascade)
}

model VerificationRequest {
  id String @id @default(cuid())
  careerProfileId String
  requestingOrgId String
  priorOrgId String
  status VerificationStatus @default(PENDING)
  tokenHash String @unique
  expiresAt DateTime
  consentedAt DateTime?
  respondedAt DateTime?
  careerProfile CareerProfile @relation(fields: [careerProfileId], references: [id], onDelete: Cascade)
  response VerificationResponse?
  createdAt DateTime @default(now())
}

model VerificationResponse {
  id String @id @default(cuid())
  requestId String @unique
  verified Boolean
  designation String?
  joinedAt DateTime?
  leftAt DateTime?
  notes String?
  createdAt DateTime @default(now())
  request VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model PublicVerificationToken {
  id String @id @default(cuid())
  careerProfileId String
  tokenHash String @unique
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  careerProfile CareerProfile @relation(fields: [careerProfileId], references: [id], onDelete: Cascade)
}

model Notification {
  id String @id @default(cuid())
  userId String
  type String
  title String
  message String
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model AuditEvent {
  id String @id @default(cuid())
  actorUserId String?
  action String
  entityType String
  entityId String
  metadata Json?
  createdAt DateTime @default(now())
}
