generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
  CLAIM_PENDING
}

enum UserRole {
  EMPLOYEE
  EMPLOYER
  ADMIN
}

enum EmploymentStatus {
  ACTIVE
  LEFT
  DISPUTED
}

enum VerificationStatus {
  PENDING
  APPROVED
  VERIFIED
  REJECTED
  DISPUTED
  EXPIRED
}

model User {
  id String @id @default(cuid())
  email String @unique
  phone String? @unique
  passwordHash String
  name String
  accountStatus AccountStatus @default(ACTIVE)
  role UserRole @default(EMPLOYEE)
  invitedAt DateTime?
  activatedAt DateTime?
  careerProfile CareerProfile?
  organizationMemberships OrganizationMember[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notifications Notification[]
  passwordResetTokens PasswordResetToken[]
  employerOrganizationRequests Organization[] @relation("EmployerOwner")
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model CareerProfile {
  id String @id @default(cuid())
  userId String @unique
  careerId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  employments EmploymentRecord[]
  verificationRequests VerificationRequest[]
  publicVerificationTokens PublicVerificationToken[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id String @id @default(cuid())
  name String
  cin String?
  gstin String?
  verifiedAt DateTime?
  verificationStatus String @default("PENDING")
  certificatePath String?
  reviewedAt DateTime?
  reviewNote String?
  createdByUserId String?
  createdByUser User? @relation("EmployerOwner", fields: [createdByUserId], references: [id])
  members OrganizationMember[]
  employments EmploymentRecord[]
  branding OrganizationBranding?
  integrationKeys IntegrationApiKey[]
  webhooks IntegrationWebhook[]
  importBatches HRMSImportBatch[]
  employeeAccounts CompanyEmployeeAccount[]
  employeeInvites EmployeeInvite[]
  salaryStructures SalaryStructure[]
  leavePolicies LeavePolicy[]
  leaveRequests LeaveRequest[]
  payrollCompliance PayrollComplianceConfig?
  payrollRuns PayrollRun[]
  createdAt DateTime @default(now())
}

model OrganizationBranding {
  id String @id @default(cuid())
  organizationId String @unique
  logoUrl String?
  primaryColor String?
  secondaryColor String?
  tagline String?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model IntegrationApiKey {
  id String @id @default(cuid())
  organizationId String
  name String
  keyPrefix String
  keyHash String @unique
  scopes String
  lastUsedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, revokedAt])
}

model IntegrationWebhook {
  id String @id @default(cuid())
  organizationId String
  url String
  secretHash String
  events String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, active])
}

model HRMSImportBatch {
  id String @id @default(cuid())
  organizationId String
  status String @default("RUNNING")
  fileName String?
  totalRows Int
  importedRows Int @default(0)
  failedRows Int @default(0)
  errorMessage String?
  createdByUserId String
  createdAt DateTime @default(now())
  completedAt DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, createdAt])
}

model OrganizationMember {
  id String @id @default(cuid())
  userId String
  organizationId String
  role String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([userId, organizationId])
}

model EmploymentRecord {
  id String @id @default(cuid())
  careerProfileId String
  organizationId String
  employeeCode String?
  designation String
  department String?
  employmentType String?
  joinedAt DateTime
  leftAt DateTime?
  resignationStatus String @default("NONE")
  resignationSubmittedAt DateTime?
  resignationReason String?
  resignationNoticeDate DateTime?
  resignationWithdrawnAt DateTime?
  exitRecordedAt DateTime?
  exitReason String?
  exitRevokedAt DateTime?
  exitRevokedByUserId String?
  exitRevokeReason String?
  status EmploymentStatus @default(ACTIVE)
  source String @default("MANUAL")
  externalEmployeeId String?
  verifiedAt DateTime?
  experienceLetterRef String?
  experienceLetter ExperienceLetter?
  remarks String?
  disputes EmploymentDispute[]
  companyEmployeeAccount CompanyEmployeeAccount?
  employeeInvites EmployeeInvite[]
  exitHistory EmploymentExitEvent[]
  resignationHistory EmploymentResignationEvent[]
  salaryStructure SalaryStructure?
  leaveRequests LeaveRequest[]
  payrollEntries PayrollEntry[]
  careerProfile CareerProfile @relation(fields: [careerProfileId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId, status])
  @@index([organizationId, externalEmployeeId])
}

model LeavePolicy {
  id String @id @default(cuid())
  organizationId String
  name String
  leaveType String
  annualLimit Int
  carryForward Boolean @default(false)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveRequests LeaveRequest[]
  @@unique([organizationId, leaveType])
  @@index([organizationId, active])
}

model LeaveRequest {
  id String @id @default(cuid())
  organizationId String
  employmentRecordId String
  policyId String
  startDate DateTime
  endDate DateTime
  days Decimal @db.Decimal(8,2)
  reason String?
  status String @default("PENDING")
  decidedByUserId String?
  decisionNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employmentRecord EmploymentRecord @relation(fields: [employmentRecordId], references: [id], onDelete: Cascade)
  policy LeavePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  @@index([organizationId, status])
  @@index([employmentRecordId, startDate])
}

model SalaryStructure {
  id String @id @default(cuid())
  organizationId String
  employmentRecordId String @unique
  basic Decimal @db.Decimal(14,2)
  hra Decimal @default(0) @db.Decimal(14,2)
  allowances Decimal @default(0) @db.Decimal(14,2)
  deductions Decimal @default(0) @db.Decimal(14,2)
  effectiveFrom DateTime
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employmentRecord EmploymentRecord @relation(fields: [employmentRecordId], references: [id], onDelete: Cascade)
  @@index([organizationId, active])
}

model PayrollComplianceConfig {
  id String @id @default(cuid())
  organizationId String @unique
  pfEnabled Boolean @default(false)
  pfEmployeeRate Decimal @default(0) @db.Decimal(8,4)
  pfEmployerRate Decimal @default(0) @db.Decimal(8,4)
  esiEnabled Boolean @default(false)
  esiEmployeeRate Decimal @default(0) @db.Decimal(8,4)
  esiEmployerRate Decimal @default(0) @db.Decimal(8,4)
  professionalTaxEnabled Boolean @default(false)
  professionalTaxFixed Decimal @default(0) @db.Decimal(14,2)
  tdsEnabled Boolean @default(false)
  tdsFixed Decimal @default(0) @db.Decimal(14,2)
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Payslip {
  id String @id @default(cuid())
  payrollEntryId String @unique
  basic Decimal @db.Decimal(14,2)
  hra Decimal @default(0) @db.Decimal(14,2)
  allowances Decimal @default(0) @db.Decimal(14,2)
  gross Decimal @db.Decimal(14,2)
  pfEmployee Decimal @default(0) @db.Decimal(14,2)
  esiEmployee Decimal @default(0) @db.Decimal(14,2)
  professionalTax Decimal @default(0) @db.Decimal(14,2)
  tds Decimal @default(0) @db.Decimal(14,2)
  otherDeductions Decimal @default(0) @db.Decimal(14,2)
  totalDeductions Decimal @db.Decimal(14,2)
  netPay Decimal @db.Decimal(14,2)
  payrollEntry PayrollEntry @relation(fields: [payrollEntryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model PayrollRun {
  id String @id @default(cuid())
  organizationId String
  periodStart DateTime
  periodEnd DateTime
  status String @default("DRAFT")
  processedAt DateTime?
  createdByUserId String
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries PayrollEntry[]
  @@unique([organizationId, periodStart, periodEnd])
  @@index([organizationId, status])
}

model PayrollEntry {
  id String @id @default(cuid())
  payrollRunId String
  employmentRecordId String
  gross Decimal @db.Decimal(14,2)
  deductions Decimal @default(0) @db.Decimal(14,2)
  net Decimal @db.Decimal(14,2)
  status String @default("CALCULATED")
  payslip Payslip?
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employmentRecord EmploymentRecord @relation(fields: [employmentRecordId], references: [id], onDelete: Cascade)
  @@unique([payrollRunId, employmentRecordId])
}

model CompanyEmployeeAccount {
  id String @id @default(cuid())
  organizationId String
  employmentRecordId String @unique
  email String
  phone String?
  passwordHash String?
  status AccountStatus @default(INVITED)
  invitedAt DateTime @default(now())
  activatedAt DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employmentRecord EmploymentRecord? @relation(fields: [employmentRecordId], references: [id], onDelete: Cascade)
  @@unique([organizationId, email])
}

model EmployeeInvite {
  id String @id @default(cuid())
  organizationId String
  employmentRecordId String?
  email String
  designation String?
  department String?
  employeeCode String?
  joiningDate DateTime?
  tokenHash String @unique
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employmentRecord EmploymentRecord? @relation(fields: [employmentRecordId], references: [id], onDelete: Cascade)
  @@index([organizationId, expiresAt])
}

model EmploymentExitEvent {
  id String @id @default(cuid())
  employmentRecordId String
  action String
  reason String?
  performedByUserId String
  createdAt DateTime @default(now())
  employmentRecord EmploymentRecord @relation(fields: [employmentRecordId], references: [id], onDelete: Cascade)
  @@index([employmentRecordId, createdAt])
}

model EmploymentResignationEvent {
  id String @id @default(cuid())
  employmentRecordId String
  action String
  reason String?
  performedByUserId String
  createdAt DateTime @default(now())
  employmentRecord EmploymentRecord @relation(fields: [employmentRecordId], references: [id], onDelete: Cascade)
  @@index([employmentRecordId, createdAt])
}

model ExperienceLetter {
  id String @id @default(cuid())
  employmentRecordId String @unique
  documentRef String?
  storagePath String?
  documentHash String?
  verificationTokenHash String? @unique
  issuedAt DateTime @default(now())
  revokedAt DateTime?
  employmentRecord EmploymentRecord @relation(fields: [employmentRecordId], references: [id], onDelete: Cascade)
}

model EmploymentDispute {
  id String @id @default(cuid())
  employmentRecordId String
  raisedByUserId String
  reason String
  status String @default("OPEN")
  resolution String?
  resolvedByUserId String?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  employmentRecord EmploymentRecord @relation(fields: [employmentRecordId], references: [id], onDelete: Cascade)
}

model VerificationRequest {
  id String @id @default(cuid())
  careerProfileId String
  requestingOrgId String
  priorOrgId String
  status VerificationStatus @default(PENDING)
  tokenHash String @unique
  expiresAt DateTime
  consentedAt DateTime?
  respondedAt DateTime?
  careerProfile CareerProfile @relation(fields: [careerProfileId], references: [id], onDelete: Cascade)
  response VerificationResponse?
  createdAt DateTime @default(now())
}

model VerificationResponse {
  id String @id @default(cuid())
  requestId String @unique
  verified Boolean
  designation String?
  joinedAt DateTime?
  leftAt DateTime?
  notes String?
  createdAt DateTime @default(now())
  request VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model PublicVerificationToken {
  id String @id @default(cuid())
  careerProfileId String
  tokenHash String @unique
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  careerProfile CareerProfile @relation(fields: [careerProfileId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Notification {
  id String @id @default(cuid())
  userId String
  type String
  title String
  message String
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model AuditEvent {
  id String @id @default(cuid())
  actorUserId String?
  action String
  entityType String
  entityId String
  metadata Json?
  createdAt DateTime @default(now())
}
